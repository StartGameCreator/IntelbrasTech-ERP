APP_NAME="IntelbrasTech ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=intelbrastech
DB_USERNAME=erp_user
DB_PASSWORD=secret

REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_DRIVER=redis
SESSION_DRIVER=redis

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@intelbrastech.com.br"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=intelbrastech
AWS_ENDPOINT=http://minio:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Fiscal: use "fake" apenas em desenvolvimento/testes. Produção exige um driver real.
FISCAL_DRIVER=fake
FISCAL_ALLOW_FAKE_IN_PRODUCTION=false
FISCAL_STORAGE_DISK=local
FISCAL_SCHEMAS=PL_010_V1.30

# Integrações
ML_APP_ID=
ML_SECRET_KEY=
ML_REDIRECT_URI=http://localhost/api/v1/ml/auth/callback

SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

NFE_AMBIENTE=2
NFE_VERSAO=4.00

VITE_API_URL=http://localhost/api/v1
