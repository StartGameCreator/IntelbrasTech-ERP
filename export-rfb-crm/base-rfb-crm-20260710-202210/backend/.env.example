APP_NAME="IntelbrasTech ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost

FRONTEND_URL=http://localhost:5173

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Banco de dados ──
# Padrão: SQLite — não precisa de nenhum servidor rodando, o arquivo já vem
# criado em database/database.sqlite. Ótimo para rodar localmente sem Docker.
DB_CONNECTION=sqlite
# DB_DATABASE=/caminho/absoluto/para/database.sqlite   # opcional; o padrão já aponta para database/database.sqlite

# Para usar PostgreSQL em vez de SQLite (recomendado em produção, já vem
# pronto no docker/docker-compose.yml), troque as linhas acima por:
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=intelbrastech
# DB_USERNAME=erp_user
# DB_PASSWORD=secret

# ── Sessão, Cache e Filas ──
# Padrão sem dependências externas (arquivo local / execução síncrona).
# Se for rodar via docker-compose com Redis disponível, troque os três para "redis".
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=secret
REDIS_PORT=6379

# ── RabbitMQ (mensageria para integrações assíncronas — opcional) ──
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=admin
RABBITMQ_PASS=secret

# ── Storage (MinIO em dev via Docker, S3 real em produção) ──
# Necessário para upload de imagens de produto, fotos de OS e PDFs
# (DANFE, comprovante de OS, recibo). Sem isso configurado, esses uploads falham.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=intelbrastech
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/intelbrastech
AWS_USE_PATH_STYLE_ENDPOINT=true

# ── E-mail (Mailpit em dev) ──
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@intelbrastech.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# ── CORS / Sanctum (frontend Vue rodando em :5173) ──
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000

# ── SEFAZ (Fiscal) ──
SEFAZ_AMBIENTE=2

# ── Integrações de Marketplace (opcional; também configurável por empresa) ──
MERCADOLIVRE_CLIENT_ID=
MERCADOLIVRE_CLIENT_SECRET=
MERCADOLIVRE_REDIRECT_URI=
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_REDIRECT_URI=

VITE_API_URL=http://localhost/api/v1
VITE_APP_NAME="IntelbrasTech ERP"
